# Health Assist API — example configuration.
# Copy to .env for local development:  cp .env.example .env
# Real environment variables always take precedence over .env.
# Never commit a real .env file.

# development | test | production
APP_ENV=development
PORT=8080
# debug | info | warn | error  (debug also prints Gin's route table at startup)
LOG_LEVEL=info

# REQUIRED. At least 32 bytes. Generate with:  openssl rand -base64 48
# There is intentionally no default; the server refuses to start without it.
JWT_SECRET=
JWT_ISSUER=health-assist-api
JWT_AUDIENCE=health-assist-app
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# bcrypt work factor (10–31; 12 recommended)
BCRYPT_COST=12

# Comma-separated browser origins allowed to call the API.
# "scheme://host:*" allows any port (development only; Flutter Web uses random ports).
# Defaults outside production: http://localhost:*,http://127.0.0.1:*
# In production list exact origins, e.g. https://app.healthassist.example
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
# Max JSON request body in bytes (1 MiB). File uploads will get their own limit.
HTTP_MAX_BODY_BYTES=1048576

# ── PostgreSQL (LOCAL DEVELOPMENT values) ───────────────────────────────
# Create the role/database with: .\scripts\db\setup-local.ps1
# Put the password you chose there in DATABASE_PASSWORD. Never commit .env.
# Production settings are documented in docs/DATABASE.md ("Production settings").
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=health_assist
DATABASE_USER=health_assist_user
DATABASE_PASSWORD=
# disable is acceptable only for localhost. Production requires verify-full.
DATABASE_SSLMODE=disable
# DATABASE_SSLROOTCERT=C:\path\to\ca.pem   (for verify-ca / verify-full)

# Pool and timeouts (defaults shown)
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=0
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_STATEMENT_TIMEOUT=30s

# ── File storage (medical records, lab reports, prescriptions) ──────────
# Private local disk: files are stored under random names, never served
# statically, and downloaded only through short-lived signed links that are
# re-authorised on every request. Keep this folder out of Git and backups
# you do not control. Production: an encrypted, access-restricted volume.
# Retention and deletion: ../docs/FILE_STORAGE_AND_RETENTION.md
STORAGE_DIR=storage
STORAGE_MAX_UPLOAD_BYTES=10485760
FILE_LINK_TTL=5m

# ── AI Assistant (optional) ───────────────────────────────────────────────
# Leave AI_API_KEY empty to run without AI: the AI screens then say that AI
# is not set up, emergency guidance still works, and every other feature is
# unaffected. Setup guide: ../docs/API_KEYS_AND_SETUP.md
# The key is a server-side secret. Never put it in Flutter code or Git.
AI_PROVIDER=gemini
AI_API_KEY=
# Check current model ids at https://ai.google.dev/gemini-api/docs/models
AI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT=45s
# Per patient, per API instance.
AI_RATE_LIMIT_PER_MINUTE=6
AI_RATE_LIMIT_PER_DAY=100
# Max image/PDF size sent for analysis (bytes, up to 15 MiB).
AI_MAX_UPLOAD_BYTES=8388608

# ── Online payments (optional) ───────────────────────────────────────────
# Leave PAYMENT_PROVIDER empty to keep payments offline (pay at the clinic,
# at sample collection, cash on delivery). Setup: ../docs/API_KEYS_AND_SETUP.md
#   razorpay  – real Razorpay integration (test or live keys)
#   simulator – DEVELOPMENT ONLY: no money moves, every payment is stored as
#               "simulated" and labelled in the app; refused in production
PAYMENT_PROVIDER=
# test | live. Must match the key prefix (rzp_test_ / rzp_live_).
# live is only accepted with APP_ENV=production.
RAZORPAY_MODE=test
# Key ID is public (sent to the app for Checkout); the two secrets are not.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: the previous webhook secret, kept while Razorpay retries events
# signed before a rotation. Remove it once old retries have stopped.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
# Shown in Checkout (max 60 characters).
PAYMENT_BUSINESS_NAME=Health Assist
PAYMENT_TIMEOUT=15s

# ── Email notifications (optional) ───────────────────────────────────────
# In-app notifications always work. Leave EMAIL_PROVIDER empty to send no
# email (no credentials needed for local development).
#   smtp – any SMTP provider over TLS (587/2525 STARTTLS or 465)
#   log  – DEVELOPMENT ONLY: logs "email NOT sent" with a masked address;
#          refused in production
EMAIL_PROVIDER=
EMAIL_FROM=Health Assist <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Background worker: outbox poll interval and attempts before giving up
# (retries back off 1, 2, 4 … minutes, up to 6 hours).
EMAIL_POLL_INTERVAL=15s
EMAIL_MAX_ATTEMPTS=6
# Linked from emails ("open Health Assist"): where users open the app.
APP_PUBLIC_URL=http://localhost:8080

# ── Development seed (go run ./cmd/seed) ────────────────────────────────
# Shared login password for the FICTIONAL seeded accounts. Choose your own;
# 8+ chars with a letter and a digit. Ignored by the API server.
SEED_USER_PASSWORD=

# ── Integration tests (go test ./...) ───────────────────────────────────
# Optional. The database name MUST end in _test: tests erase all its rows.
# TEST_DATABASE_URL=postgres://health_assist_user:<password>@localhost:5432/health_assist_test?sslmode=disable
